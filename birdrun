
import pygame
import random
import sys
import json
import os
import math

# Use the SAME leaderboard helper as Tetris and Flappy Bird
try:
    from leaderboard import submit_final_score
except ImportError:
    submit_final_score = None
    print("Warning: leaderboard.py could not be imported.")

# Initialize pygame
pygame.init()

# -----------------------------
# PLAYER AND GAME SETTINGS
# -----------------------------

PLAYER_NAME = os.environ.get("PLAYER_NAME", "Player")
GAME_ID = os.environ.get("GAME_ID", "bird_run")

WIDTH = 800
HEIGHT = 400

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Bird Run")

clock = pygame.time.Clock()

font = pygame.font.SysFont("Arial", 25, bold=True)
big_font = pygame.font.SysFont("Arial", 55, bold=True)
small_font = pygame.font.SysFont("Arial", 19)

# Colors
WHITE = (255, 255, 255)
BLACK = (30, 30, 30)
GREEN = (40, 160, 60)
DARK_GREEN = (25, 110, 45)
GRAY = (120, 120, 120)
ORANGE = (220, 130, 40)
YELLOW = (255, 225, 30)
DARK_YELLOW = (220, 160, 20)
BELLY = (255, 245, 180)
SKY = (190, 230, 255)
CLOUD = (255, 255, 255)
RED = (200, 50, 50)

# Ground
GROUND_Y = 320

# -----------------------------
# BIRD SETTINGS
# -----------------------------

bird = pygame.Rect(80, GROUND_Y - 55, 50, 55)

velocity_y = 0
gravity = 0.8
jump_power = -15
on_ground = True

# -----------------------------
# OBSTACLE SETTINGS
# -----------------------------

obstacles = []

spawn_timer = 0
spawn_delay = 90

game_speed = 6

# -----------------------------
# SCORE SETTINGS
# -----------------------------

score = 0
high_score = 0

game_over = False

# Leaderboard submission tracking
score_submitted = False
submission = None
submission_status_text = "Not submitted"

# Animation
animation_timer = 0
ground_offset = 0
spinner_angle = 0

# -----------------------------
# HIGH SCORE FILE
# -----------------------------

HIGH_SCORE_FILE = os.path.join(
    os.path.dirname(os.path.abspath(__file__)),
    "bird_run_high_score.json"
)


def load_high_score():
    try:
        with open(HIGH_SCORE_FILE, "r") as file:
            data = json.load(file)
            return int(data.get("high_score", 0))

    except (FileNotFoundError, json.JSONDecodeError,
            TypeError, ValueError, OSError):
        return 0


def save_high_score(value):
    try:
        with open(HIGH_SCORE_FILE, "w") as file:
            json.dump({"high_score": value}, file)

    except OSError:
        print("Could not save high score.")


high_score = load_high_score()


def update_high_score():
    global high_score

    if score // 10 > high_score:
        high_score = score // 10
        save_high_score(high_score)


# -----------------------------
# LEADERBOARD SUBMISSION
# -----------------------------

def upload_score():
    global score_submitted
    global submission
    global submission_status_text

    if score_submitted:
        return

    score_submitted = True
    submission_status_text = "Uploading score..."

    if submit_final_score is None:
        submission_status_text = "Leaderboard helper missing"
        return

    final_score = score // 10

    print("Uploading Bird Run score...")
    print("Player:", PLAYER_NAME)
    print("Score:", final_score)

    try:
        # Uses the same asynchronous helper as the other games.
        # Its status changes as the server responds.
        submission = submit_final_score(
            GAME_ID,
            PLAYER_NAME,
            final_score
        )

    except Exception as error:
        print("Could not start score upload:", error)
        submission_status_text = "Could not upload score"


def get_submission_status():
    if submission is not None:
        return getattr(
            submission,
            "status",
            submission_status_text
        )

    return submission_status_text


# -----------------------------
# DRAW UPLOAD LOADING SPINNER
# -----------------------------

def draw_loading_spinner(center_x, center_y):
    global spinner_angle

    spinner_angle += 8

    for i in range(8):
        angle = math.radians(spinner_angle + i * 45)

        x = center_x + math.cos(angle) * 13
        y = center_y + math.sin(angle) * 13

        brightness = 70 + i * 22
        brightness = min(brightness, 230)

        pygame.draw.circle(
            screen,
            (brightness, brightness, brightness),
            (int(x), int(y)),
            4
        )


# -----------------------------
# DRAW BACKGROUND
# -----------------------------

clouds = [
    [100, 75],
    [350, 115],
    [620, 65],
    [850, 130]
]


def draw_cloud(x, y):
    pygame.draw.circle(screen, CLOUD, (x, y), 17)
    pygame.draw.circle(screen, CLOUD, (x + 20, y - 10), 22)
    pygame.draw.circle(screen, CLOUD, (x + 42, y), 17)
    pygame.draw.rect(screen, CLOUD, (x, y, 42, 17))


def draw_background():
    screen.fill(SKY)

    # Clouds
    for cloud in clouds:
        draw_cloud(cloud[0], cloud[1])

    # Ground
    pygame.draw.rect(
        screen,
        (220, 195, 145),
        (0, GROUND_Y, WIDTH, HEIGHT - GROUND_Y)
    )

    pygame.draw.line(
        screen,
        BLACK,
        (0, GROUND_Y),
        (WIDTH, GROUND_Y),
        3
    )

    # Moving ground details
    for x in range(-40, WIDTH + 40, 40):
        ground_x = (x - ground_offset) % (WIDTH + 40)

        pygame.draw.line(
            screen,
            (170, 140, 100),
            (ground_x, GROUND_Y + 20),
            (ground_x - 12, GROUND_Y + 24),
            2
        )


# -----------------------------
# DRAW BIRD CHARACTER
# -----------------------------

def draw_bird():
    x = bird.x
    y = bird.y

    # Tail
    pygame.draw.polygon(
        screen,
        ORANGE,
        [
            (x + 5, y + 25),
            (x - 10, y + 15),
            (x - 7, y + 32)
        ]
    )

    # Body
    pygame.draw.ellipse(
        screen,
        YELLOW,
        (x + 3, y + 5, 45, 38)
    )

    # Belly
    pygame.draw.ellipse(
        screen,
        BELLY,
        (x + 18, y + 25, 22, 15)
    )

    # Wing
    pygame.draw.ellipse(
        screen,
        DARK_YELLOW,
        (x + 10, y + 23, 27, 17)
    )

    # Head feathers
    pygame.draw.polygon(
        screen,
        YELLOW,
        [
            (x + 12, y + 9),
            (x + 13, y - 1),
            (x + 21, y + 7),
            (x + 27, y - 3),
            (x + 29, y + 9)
        ]
    )

    # Beak
    pygame.draw.polygon(
        screen,
        ORANGE,
        [
            (x + 43, y + 13),
            (x + 58, y + 20),
            (x + 43, y + 25)
        ]
    )

    # Tongue sticking out
    pygame.draw.polygon(
        screen,
        (230, 55, 85),
        [
            (x + 54, y + 20),
            (x + 65, y + 21),
            (x + 61, y + 27),
            (x + 57, y + 24)
        ]
    )

    # Eye
    pygame.draw.circle(
        screen,
        WHITE,
        (x + 36, y + 12),
        7
    )

    pygame.draw.circle(
        screen,
        BLACK,
        (x + 38, y + 12),
        3
    )

    pygame.draw.circle(
        screen,
        WHITE,
        (x + 39, y + 11),
        1
    )

    # Animated feet
    if on_ground and not game_over:
        foot_offset = (animation_timer // 6) % 2 * 4
    else:
        foot_offset = 0

    pygame.draw.line(
        screen,
        ORANGE,
        (x + 18, y + 43),
        (x + 16, y + 52 + foot_offset),
        3
    )

    pygame.draw.line(
        screen,
        ORANGE,
        (x + 35, y + 43),
        (x + 37, y + 52 - foot_offset),
        3
    )


# -----------------------------
# DRAW OBSTACLE
# -----------------------------

def draw_obstacle(obstacle):
    pygame.draw.rect(screen, GREEN, obstacle)

    pygame.draw.rect(
        screen,
        GREEN,
        (obstacle.x - 8, obstacle.y + 15, 8, 10)
    )

    pygame.draw.rect(
        screen,
        GREEN,
        (
            obstacle.x + obstacle.width,
            obstacle.y + 8,
            8,
            10
        )
    )

    pygame.draw.line(
        screen,
        DARK_GREEN,
        (obstacle.x + 5, obstacle.y + 10),
        (obstacle.x + 5, obstacle.bottom - 5),
        2
    )


# -----------------------------
# DRAW LEADERBOARD STATUS
# -----------------------------

def draw_leaderboard_status():
    status = get_submission_status()

    # Player and final score
    player_text = small_font.render(
        f"Player: {PLAYER_NAME}   Final score: {score // 10}",
        True,
        BLACK
    )

    screen.blit(
        player_text,
        player_text.get_rect(
            center=(WIDTH // 2, 210)
        )
    )

    # Uploading
    if status == "Uploading score...":

        status_color = (70, 90, 130)

        status_text = font.render(
            "Uploading score...",
            True,
            status_color
        )

        status_rect = status_text.get_rect(
            center=(WIDTH // 2 + 15, 265)
        )

        screen.blit(status_text, status_rect)

        # Animated loading symbol
        draw_loading_spinner(
            status_rect.left - 23,
            status_rect.centery
        )

    # Successful upload
    elif status == "Score uploaded!":

        status_text = font.render(
            "Score uploaded successfully!",
            True,
            (25, 140, 55)
        )

        screen.blit(
            status_text,
            status_text.get_rect(
                center=(WIDTH // 2, 265)
            )
        )

    # Server offline
    elif status == "Offline mode: score not uploaded":

        status_text = font.render(
            "Offline mode: score not uploaded",
            True,
            RED
        )

        screen.blit(
            status_text,
            status_text.get_rect(
                center=(WIDTH // 2, 265)
            )
        )

    # Server rejected score
    elif status == "Score rejected by server":

        status_text = font.render(
            "Score rejected by server",
            True,
            RED
        )

        screen.blit(
            status_text,
            status_text.get_rect(
                center=(WIDTH // 2, 265)
            )
        )

    # Other errors
    else:

        status_text = font.render(
            status,
            True,
            RED
        )

        screen.blit(
            status_text,
            status_text.get_rect(
                center=(WIDTH // 2, 265)
            )
        )


# -----------------------------
# RESET GAME
# -----------------------------

def reset_game():
    global score, game_speed, obstacles
    global game_over, velocity_y, on_ground
    global spawn_timer, spawn_delay
    global score_submitted, submission
    global submission_status_text
    global animation_timer, ground_offset
    global spinner_angle

    score = 0
    game_speed = 6

    obstacles = []

    spawn_timer = 0
    spawn_delay = 90

    velocity_y = 0
    on_ground = True

    bird.y = GROUND_Y - 55

    game_over = False

    # Reset leaderboard state for the next game
    score_submitted = False
    submission = None
    submission_status_text = "Not submitted"

    animation_timer = 0
    ground_offset = 0
    spinner_angle = 0


# -----------------------------
# MAIN GAME LOOP
# -----------------------------

while True:

    clock.tick(60)
    animation_timer += 1

    # Events
    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if event.type == pygame.KEYDOWN:

            # Jump or restart
            if event.key in (pygame.K_SPACE, pygame.K_UP):

                if game_over:
                    reset_game()

                elif on_ground:
                    velocity_y = jump_power
                    on_ground = False

            if event.key == pygame.K_r and game_over:
                reset_game()

            if event.key == pygame.K_ESCAPE:
                pygame.quit()
                sys.exit()

    # Draw background
    draw_background()

    if not game_over:

        # -----------------------------
        # BIRD PHYSICS
        # -----------------------------

        velocity_y += gravity
        bird.y += int(velocity_y)

        # Land on ground
        if bird.bottom >= GROUND_Y:

            bird.bottom = GROUND_Y
            velocity_y = 0
            on_ground = True

        # -----------------------------
        # MOVE BACKGROUND
        # -----------------------------

        ground_offset += game_speed

        for cloud in clouds:
            cloud[0] -= 1

            if cloud[0] < -70:
                cloud[0] = WIDTH + random.randint(20, 150)

        # -----------------------------
        # SPAWN OBSTACLES
        # -----------------------------

        spawn_timer += 1

        if spawn_timer >= spawn_delay:

            height = random.choice([35, 45, 55])

            obstacle = pygame.Rect(
                WIDTH,
                GROUND_Y - height,
                25,
                height
            )

            obstacles.append(obstacle)

            spawn_timer = 0
            spawn_delay = random.randint(65, 110)

        # -----------------------------
        # MOVE OBSTACLES
        # -----------------------------

        for obstacle in obstacles:
            obstacle.x -= game_speed

        obstacles = [
            obs for obs in obstacles if obs.right > 0
        ]

        # -----------------------------
        # COLLISION DETECTION
        # -----------------------------

        for obstacle in obstacles:

            if bird.colliderect(obstacle):

                game_over = True
                update_high_score()

                # Submit score exactly once
                upload_score()

                break

        # -----------------------------
        # UPDATE SCORE
        # -----------------------------

        if not game_over:
            score += 1
            update_high_score()

        # -----------------------------
        # INCREASE DIFFICULTY
        # -----------------------------

        if score > 0 and score % 500 == 0:
            game_speed += 0.5

    # Draw obstacles
    for obstacle in obstacles:
        draw_obstacle(obstacle)

    # Draw bird
    draw_bird()

    # Display score
    score_text = font.render(
        f"Score: {score // 10}",
        True,
        BLACK
    )

    screen.blit(score_text, (WIDTH - 180, 20))

    # Display high score
    high_text = font.render(
        f"Best: {high_score}",
        True,
        BLACK
    )

    screen.blit(high_text, (20, 20))

    # Instructions
    if score == 0 and not game_over:

        instruction = font.render(
            "Press SPACE or UP to jump!",
            True,
            BLACK
        )

        screen.blit(
            instruction,
            instruction.get_rect(
                center=(WIDTH // 2, 180)
            )
        )

    # -----------------------------
    # GAME OVER SCREEN
    # -----------------------------

    if game_over:

        # Dark translucent overlay
        overlay = pygame.Surface((WIDTH, HEIGHT))
        overlay.set_alpha(170)
        overlay.fill(WHITE)
        screen.blit(overlay, (0, 0))

        message = big_font.render(
            "GAME OVER!",
            True,
            BLACK
        )

        screen.blit(
            message,
            message.get_rect(
                center=(WIDTH // 2, 145)
            )
        )

        # Show upload status and loading spinner
        draw_leaderboard_status()

        restart = small_font.render(
            "Press SPACE or R to restart",
            True,
            GRAY
        )

        screen.blit(
            restart,
            restart.get_rect(
                center=(WIDTH // 2, 345)
            )
        )

    pygame.display.update()

