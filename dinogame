
import pygame
import random
import sys

# Initialize pygame
pygame.init()

# Screen settings
WIDTH = 800
HEIGHT = 400
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Dinosaur Run!")

clock = pygame.time.Clock()
font = pygame.font.SysFont("Arial", 28, bold=True)
big_font = pygame.font.SysFont("Arial", 55, bold=True)

# Colors
WHITE = (255, 255, 255)
BLACK = (30, 30, 30)
GREEN = (40, 160, 60)
GRAY = (120, 120, 120)
ORANGE = (220, 130, 40)

# Ground
GROUND_Y = 320

# Dinosaur
dino = pygame.Rect(80, GROUND_Y - 55, 45, 55)
velocity_y = 0
gravity = 0.8
jump_power = -15
on_ground = True

# Obstacles
obstacles = []
spawn_timer = 0
spawn_delay = 90
game_speed = 6

# Score
score = 0
high_score = 0
game_over = False

def draw_dino():
    # Body and head
    pygame.draw.rect(screen, GREEN, dino)
    pygame.draw.rect(screen, GREEN,
                     (dino.x + 25, dino.y - 18, 30, 25))

    # Eye
    pygame.draw.circle(screen, WHITE,
                       (dino.x + 47, dino.y - 8), 4)

    # Legs
    pygame.draw.rect(screen, GREEN,
                     (dino.x + 5, dino.bottom - 5, 10, 12))
    pygame.draw.rect(screen, GREEN,
                     (dino.x + 27, dino.bottom - 5, 10, 12))

def draw_obstacle(obstacle):
    pygame.draw.rect(screen, ORANGE, obstacle)
    pygame.draw.rect(screen, ORANGE,
                     (obstacle.x - 8, obstacle.y + 15, 8, 10))
    pygame.draw.rect(screen, ORANGE,
                     (obstacle.x + obstacle.width, obstacle.y + 8, 8, 10))

def reset_game():
    global score, game_speed, obstacles
    global game_over, velocity_y, on_ground, spawn_timer

    score = 0
    game_speed = 6
    obstacles = []
    spawn_timer = 0
    velocity_y = 0
    on_ground = True
    dino.y = GROUND_Y - 55
    game_over = False

# Main game loop
while True:

    clock.tick(60)

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_SPACE:

                if game_over:
                    reset_game()

                elif on_ground:
                    velocity_y = jump_power
                    on_ground = False

            if event.key == pygame.K_r and game_over:
                reset_game()

    screen.fill(WHITE)

    # Ground
    pygame.draw.line(screen, BLACK,
                     (0, GROUND_Y), (WIDTH, GROUND_Y), 3)

    if not game_over:

        # Dinosaur physics
        velocity_y += gravity
        dino.y += int(velocity_y)

        if dino.bottom >= GROUND_Y:
            dino.bottom = GROUND_Y
            velocity_y = 0
            on_ground = True

        # Spawn obstacles
        spawn_timer += 1

        if spawn_timer >= spawn_delay:
            height = random.choice([35, 45, 55])
            obstacle = pygame.Rect(
                WIDTH,
                GROUND_Y - height,
                25,
                height
            )
            obstacles.append(obstacle)
            spawn_timer = 0
            spawn_delay = random.randint(65, 110)

        # Move obstacles
        for obstacle in obstacles:
            obstacle.x -= game_speed

        # Remove obstacles off screen
        obstacles = [
            obs for obs in obstacles if obs.right > 0
        ]

        # Collision detection
        for obstacle in obstacles:
            if dino.colliderect(obstacle):
                game_over = True

        # Update score
        score += 1
        high_score = max(high_score, score)

        # Increase difficulty
        if score % 500 == 0:
            game_speed += 0.5

    # Draw dinosaur
    draw_dino()

    # Draw obstacles
    for obstacle in obstacles:
        draw_obstacle(obstacle)

    # Display score
    score_text = font.render(
        f"Score: {score // 10}", True, BLACK
    )
    screen.blit(score_text, (WIDTH - 180, 20))

    high_text = font.render(
        f"Best: {high_score // 10}", True, BLACK
    )
    screen.blit(high_text, (20, 20))

    # Game over screen
    if game_over:

        message = big_font.render(
            "GAME OVER!", True, BLACK
        )

        restart = font.render(
            "Press SPACE or R to restart", True, GRAY
        )

        screen.blit(
            message,
            message.get_rect(center=(WIDTH // 2, 160))
        )

        screen.blit(
            restart,
            restart.get_rect(center=(WIDTH // 2, 220))
        )

    pygame.display.update()
