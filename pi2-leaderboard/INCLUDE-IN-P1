import requests

# Replace with Pi #2's static IP address or hostname
SERVER_URL = "http://10.83.4.202:5000/score"


def submit_final_score(game_name, player_name, final_score):
  payload = {"game": game_name, "name": player_name, "score": final_score}

  try:
    response = requests.post(SERVER_URL, json=payload, timeout=2.0)
    if response.status_code == 201:
      print("Score successfully posted to leaderboard!")
      return True
    else:
      print(f"Server rejected score: {response.status_code}")
      return False
  except requests.exceptions.RequestException as e:
    # Network or server is down; handle gracefully without crashing
    print(f"Network warning: Could not reach scoreboard server ({e})")
    return False

