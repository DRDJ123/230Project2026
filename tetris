        BOARD_WIDTH + 25,
        485
    )

    controls = [
        "LEFT / RIGHT  Move",
        "UP            Rotate",
        "DOWN          Soft drop",
        "SPACE         Hard drop",
        "R             Restart",
        "P             Pause",
        "ESC           Quit"
    ]

    for i, text in enumerate(controls):

        draw_text(
            text,
            10,
            GRAY,
            BOARD_WIDTH + 12,
            505 + i * 13
        )


# -----------------------------
# MAIN GAME
# -----------------------------
def main():

    global high_score
   
    score_submitted = False
    submission = None
  
    board = create_board()

    current_piece = Piece()
    next_piece = Piece()

    score = 0
    lines = 0
    level = 1

    fall_time = 0
    fall_speed = 700

    game_over = False
    paused = False
    running = True

    while running:

        dt = clock.tick(60)

        if not paused and not game_over:
            fall_time += dt

        # -------------------------
        # EVENTS
        # -------------------------
        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                running = False

            if event.type == pygame.KEYDOWN:

                if event.key == pygame.K_ESCAPE:
                    running = False

                # Restart
                if event.key == pygame.K_r:

                    board = create_board()
                    current_piece = Piece()
                    next_piece = Piece()

                    score = 0
                    lines = 0
                    level = 1

                    score_submitted = False
                    submission = None
                    
                    fall_time = 0
                    game_over = False
                    paused = False

                # Pause
                if event.key == pygame.K_p and not game_over:
                    paused = not paused

                if game_over or paused:
                    continue

                # Move left
                if event.key == pygame.K_LEFT:

                    current_piece.x -= 1

                    if not valid_position(board, current_piece):
                        current_piece.x += 1

                # Move right
                elif event.key == pygame.K_RIGHT:

                    current_piece.x += 1

                    if not valid_position(board, current_piece):
                        current_piece.x -= 1

                # Rotate
                elif event.key == pygame.K_UP:

                    old_shape = current_piece.shape

                    current_piece.rotate()

                    if not valid_position(board, current_piece):
                        current_piece.shape = old_shape

                # Soft drop
                elif event.key == pygame.K_DOWN:

                    current_piece.y += 1

                    if valid_position(board, current_piece):
                        score += 1
                        update_high_score(score)

                    else:
                        current_piece.y -= 1

                # Hard drop
                elif event.key == pygame.K_SPACE:

                    while True:

                        current_piece.y += 1

                        if not valid_position(board, current_piece):
                            current_piece.y -= 1
                            break

                        score += 2

                    update_high_score(score)
                    fall_time = fall_speed

        # -------------------------
        # AUTOMATIC FALLING
        # -------------------------
        if not game_over and not paused:

            fall_speed = max(
                100,
                700 - (level - 1) * 55
            )

            if fall_time >= fall_speed:

                current_piece.y += 1

                if not valid_position(board, current_piece):

                    current_piece.y -= 1

                    if not lock_piece(board, current_piece):

                        game_over = True
                        update_high_score(score)

                    else:

                        cleared = clear_lines(board)

                        if cleared == 1:
                            score += 100 * level

                        elif cleared == 2:
                            score += 300 * level

                        elif cleared == 3:
                            score += 500 * level

                        elif cleared == 4:
                            score += 800 * level

                        lines += cleared
                        level = lines // 10 + 1

                        update_high_score(score)

                        current_piece = next_piece
                        next_piece = Piece()

                        if not valid_position(board, current_piece):
                            game_over = True
                            update_high_score(score)

                fall_time = 0

        # -------------------------
        # Submit final score once when the game ends
        if game_over and not score_submitted:

            submission = submit_final_score(
                GAME_ID,
                PLAYER_NAME,
                score
            )

            score_submitted = True
        # DRAW EVERYTHING
        # -------------------------
        draw_board(board)
        draw_piece(current_piece)

        draw_sidebar(
            score,
            lines,
            level,
            next_piece
        )

        # Paused screen
        if paused:

            overlay = pygame.Surface(
                (BOARD_WIDTH, BOARD_HEIGHT),
                pygame.SRCALPHA
            )

            overlay.fill((0, 0, 0, 190))

            screen.blit(overlay, (0, 0))

            draw_text(
                "PAUSED",
                35,
                YELLOW,
                75,
                SCREEN_HEIGHT // 2
            )

        # Game over screen
        if game_over:

            overlay = pygame.Surface(
                (BOARD_WIDTH, BOARD_HEIGHT),
                pygame.SRCALPHA
            )

            overlay.fill((0, 0, 0, 190))

            screen.blit(overlay, (0, 0))

            draw_text(
                "GAME OVER",
                32,
                RED,
                35,
                SCREEN_HEIGHT // 2 - 60
            )

            draw_text(
                f"SCORE: {score}",
                20,
                WHITE,
                55,
                SCREEN_HEIGHT // 2 - 20
            )

            draw_text(
                f"HIGH SCORE: {high_score}",
                18,
                YELLOW,
                40,
                SCREEN_HEIGHT // 2 + 10
            )

            draw_text(
                "Press R to Restart",
                17,
                WHITE,
                42,
                SCREEN_HEIGHT // 2 + 45
            )
            if submission:
                draw_text(
                    submission.status,
                    12,
                    GREEN if submission.status == "Score uploaded!" else GRAY,
                    20,
                    SCREEN_HEIGHT // 2 + 80
                )
        pygame.display.update()

    pygame.quit()


if __name__ == "__main__":
    main()
