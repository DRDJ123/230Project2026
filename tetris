    )

    # Title and bird logo
    draw_text(
        "TETRIS",
        30,
        CYAN,
        BOARD_WIDTH + 20,
        20
    )

    draw_bird()

    # Score
    draw_text(
        "SCORE",
        16,
        WHITE,
        BOARD_WIDTH + 25,
        75
    )

    draw_text(
        score,
        24,
        YELLOW,
        BOARD_WIDTH + 25,
        96
    )

    # High score
    draw_text(
        "HIGH SCORE",
        15,
        WHITE,
        BOARD_WIDTH + 25,
        133
    )

    draw_text(
        high_score,
        22,
        YELLOW,
        BOARD_WIDTH + 25,
        153
    )

    # Lines
    draw_text(
        "LINES",
        16,
        WHITE,
        BOARD_WIDTH + 25,
        195
    )

    draw_text(
        lines,
        23,
        GREEN,
        BOARD_WIDTH + 25,
        215
    )

    # Level
    draw_text(
        "LEVEL",
        16,
        WHITE,
        BOARD_WIDTH + 25,
        252
    )

    draw_text(
        level,
        23,
        ORANGE,
        BOARD_WIDTH + 25,
        272
    )

    # Next piece preview
    draw_text(
