import pygame
import random
import sys
import json
import os

# Initialize pygame
pygame.init()

# Screen settings
WIDTH = 800
HEIGHT = 400
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Bird Run")

clock = pygame.time.Clock()
font = pygame.font.SysFont("Arial", 28, bold=True)
big_font = pygame.font.SysFont("Arial", 55, bold=True)

# Colors
WHITE = (255, 255, 255)
BLACK = (30, 30, 30)
GREEN = (40, 160, 60)
GRAY = (120, 120, 120)
ORANGE = (220, 130, 40)
YELLOW = (255, 225, 30)
DARK_YELLOW = (220, 160, 20)
BELLY = (255, 245, 180)

# Ground
GROUND_Y = 320

# Bird
bird = pygame.Rect(80, GROUND_Y - 55, 50, 55)
velocity_y = 0
gravity = 0.8
jump_power = -15
on_ground = True

# Obstacles
obstacles = []
spawn_timer = 0
spawn_delay = 90
game_speed = 6

# Score
score = 0
high_score = 0
game_over = False

# -----------------------------
# HIGH SCORE SAVING
# -----------------------------
HIGH_SCORE_FILE = os.path.join(
    os.path.dirname(os.path.abspath(__file__)),
    "bird_run_high_score.json"
)


def load_high_score():
    try:
        with open(HIGH_SCORE_FILE, "r") as file:
            data = json.load(file)
            return int(data.get("high_score", 0))
    except (FileNotFoundError, json.JSONDecodeError,
            TypeError, ValueError):
        return 0


def save_high_score(value):
    try:
        with open(HIGH_SCORE_FILE, "w") as file:
            json.dump({"high_score": value}, file)
    except OSError:
        print("Could not save high score.")


high_score = load_high_score()


def update_high_score():
    global high_score

    if score // 10 > high_score:
        high_score = score // 10
        save_high_score(high_score)


# -----------------------------
# DRAW BIRD CHARACTER
# -----------------------------
def draw_bird():
    x = bird.x
    y = bird.y

    # Tail
    pygame.draw.polygon(
        screen,
        ORANGE,
        [
            (x + 5, y + 25),
            (x - 10, y + 15),
            (x - 7, y + 32)
        ]
    )

    # Back wing
    pygame.draw.ellipse(
        screen,
        DARK_YELLOW,
        (x + 10, y + 23, 27, 17)
    )

    # Body
    pygame.draw.ellipse(
        screen,
        YELLOW,
        (x + 3, y + 5, 45, 38)
    )

    # Belly
    pygame.draw.ellipse(
        screen,
        BELLY,
        (x + 18, y + 25, 22, 15)
    )

    # Head feathers
    pygame.draw.polygon(
        screen,
        YELLOW,
        [
            (x + 12, y + 9),
            (x + 13, y - 1),
            (x + 21, y + 7),
            (x + 27, y - 3),
            (x + 29, y + 9)
        ]
    )

    # Beak
    pygame.draw.polygon(
        screen,
        ORANGE,
        [
            (x + 43, y + 13),
            (x + 58, y + 20),
            (x + 43, y + 25)
        ]
    )

    # Eye
    pygame.draw.circle(
        screen,
        WHITE,
        (x + 36, y + 12),
        7
    )

    pygame.draw.circle(
        screen,
        BLACK,
        (x + 38, y + 12),
        3
    )

    # Small highlight
    pygame.draw.circle(
        screen,
        WHITE,
        (x + 39, y + 11),
        1
    )


# -----------------------------
# DRAW OBSTACLE
# -----------------------------
def draw_obstacle(obstacle):
    pygame.draw.rect(screen, ORANGE, obstacle)

    pygame.draw.rect(
        screen,
        ORANGE,
        (obstacle.x - 8, obstacle.y + 15, 8, 10)
    )

    pygame.draw.rect(
        screen,
        ORANGE,
        (obstacle.x + obstacle.width,
         obstacle.y + 8, 8, 10)
    )


# -----------------------------
# RESET GAME
# -----------------------------
def reset_game():
    global score, game_speed, obstacles
    global game_over, velocity_y, on_ground, spawn_timer
    global spawn_delay

    score = 0
    game_speed = 6
    obstacles = []
    spawn_timer = 0
    spawn_delay = 90
    velocity_y = 0
    on_ground = True
    bird.y = GROUND_Y - 55
    game_over = False


# -----------------------------
# MAIN GAME LOOP
# -----------------------------
running = True

while running:

    clock.tick(60)

    # -----------------------------
    # EVENTS
    # -----------------------------
    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN:

            # ESCAPE TO QUIT
            if event.key == pygame.K_ESCAPE:
                running = False

            elif event.key == pygame.K_SPACE:

                if game_over:
                    reset_game()

                elif on_ground:
                    velocity_y = jump_power
                    on_ground = False

            elif event.key == pygame.K_r and game_over:
                reset_game()

    if not running:
        break

    screen.fill(WHITE)

    # Ground
    pygame.draw.line(
        screen,
        BLACK,
        (0, GROUND_Y),
        (WIDTH, GROUND_Y),
        3
    )

    if not game_over:

        # Bird physics
        velocity_y += gravity
        bird.y += int(velocity_y)

        if bird.bottom >= GROUND_Y:
            bird.bottom = GROUND_Y
            velocity_y = 0
            on_ground = True

        # Spawn obstacles
        spawn_timer += 1

        if spawn_timer >= spawn_delay:

            height = random.choice([35, 45, 55])

            obstacle = pygame.Rect(
                WIDTH,
                GROUND_Y - height,
                25,
                height
            )

            obstacles.append(obstacle)

            spawn_timer = 0
            spawn_delay = random.randint(65, 110)

        # Move obstacles
        for obstacle in obstacles:
            obstacle.x -= game_speed

        # Remove obstacles off screen
        obstacles = [
            obs for obs in obstacles if obs.right > 0
        ]

        # Collision detection
        for obstacle in obstacles:
            if bird.colliderect(obstacle):
                game_over = True
                update_high_score()

        # Update score
        score += 1
        update_high_score()

        # Increase difficulty
        if score % 500 == 0:
            game_speed += 0.5

    # Draw bird
    draw_bird()

    # Draw obstacles
    for obstacle in obstacles:
        draw_obstacle(obstacle)

    # Display score
    score_text = font.render(
        f"Score: {score // 10}", True, BLACK
    )
    screen.blit(score_text, (WIDTH - 180, 20))

    high_text = font.render(
        f"Best: {high_score}", True, BLACK
    )
    screen.blit(high_text, (20, 20))

    # Game over screen
    if game_over:

        message = big_font.render(
            "GAME OVER!", True, BLACK
        )

        restart = font.render(
            "Press SPACE or R to restart", True, GRAY
        )

        quit_text = font.render(
            "Press ESC to quit", True, GRAY
        )

        screen.blit(
            message,
            message.get_rect(
                center=(WIDTH // 2, 160)
            )
        )

        screen.blit(
            restart,
            restart.get_rect(
                center=(WIDTH // 2, 220)
            )
        )

        screen.blit(
            quit_text,
            quit_text.get_rect(
                center=(WIDTH // 2, 260)
            )
        )

    pygame.display.update()

# Close pygame cleanly
pygame.quit()
sys.exit()
