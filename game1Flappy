import pygame
import random
 
# Initialize Pygame
pygame.init()
 
# Set up the display
screen_width, screen_height = 400, 600
screen = pygame.display.set_mode((screen_width, screen_height))
pygame.display.set_caption("Flappy Bird Clone")
 
# Bird properties
bird_x = 50
bird_y = screen_height // 2
bird_radius = 20
bird_velocity = 0
gravity = 0.5
 
# Pipe properties
pipe_width = 80
pipe_gap = 150
pipe_velocity = 3
pipes = []
 
 
def create_pipe():
    pipe_height = random.randint(100, 400)
    bottom_pipe = pygame.Rect(screen_width, screen_height - pipe_height - pipe_gap, pipe_width, pipe_height)
    top_pipe = pygame.Rect(screen_width, 0, pipe_width, screen_height - pipe_height - pipe_gap)
    return bottom_pipe, top_pipe
 
 
def draw_bird():
    pygame.draw.circle(screen, (255, 0, 0), (int(bird_x), int(bird_y)), bird_radius)
 
 
def draw_pipes():
    for bottom_pipe, top_pipe in pipes:
        pygame.draw.rect(screen, (0, 255, 0), bottom_pipe)
        pygame.draw.rect(screen, (0, 255, 0), top_pipe)
 
 
def update_pipes():
    for i, (bottom_pipe, top_pipe) in enumerate(pipes):
        bottom_pipe.x -= pipe_velocity
        top_pipe.x -= pipe_velocity
        if bottom_pipe.x < -pipe_width:
            pipes.pop(i)
 
 
def check_collision():
    for bottom_pipe, top_pipe in pipes:
        if (
            bird_y + bird_radius >= screen_height
            or bird_y - bird_radius <= 0
            or pygame.Rect(bird_x - bird_radius, bird_y - bird_radius, bird_radius * 2, bird_radius * 2).colliderect(
                bottom_pipe
            )
            or pygame.Rect(bird_x - bird_radius, bird_y - bird_radius, bird_radius * 2, bird_radius * 2).colliderect(
                top_pipe
            )
        ):
            return True
    return False
 
 
clock = pygame.time.Clock()
 
running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE:
                bird_velocity = -8
 
    bird_velocity += gravity
    bird_y += bird_velocity
 
    if len(pipes) == 0 or pipes[-1][0].x < screen_width - 200:
        pipes.append(create_pipe())
 
    update_pipes()
 
    screen.fill((0, 0, 0))
    draw_bird()
    draw_pipes()
 
    if check_collision():
        running = False
 
    pygame.display.flip()
    clock.tick(60)
 
pygame.quit()
